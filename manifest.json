{
  "manifest_version": 3,
  "name": "MouseMarathon",
  "version": "1.0.0",
  "description": "Global Browser Odometer tracking physical cursor distance.",
  "permissions": ["storage"],
  "host_permissions": ["https://*.supabase.co/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "*://*.paypal.com/*",
        "*://*.chase.com/*",
        "*://*.bankofamerica.com/*",
        "*://*.wellsfargo.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["buzzer.mp3"],
      "matches": ["<all_urls>"]
    }
  ]
}